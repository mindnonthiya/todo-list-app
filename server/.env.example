# Recommended for hosted PostgreSQL providers such as Supabase or Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Local alternative when DATABASE_URL is not set.
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=todo_app
# DB_PASSWORD=your_password
# DB_PORT=5432
# DB_SSL=false

